# ─────────────────────────────────────────────────────────────
#  private-loan-eligibility — Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values.

# Network the frontend connects to: "preview" | "preprod" | "mainnet"
# Must be "preview" or "preprod" for development. "mainnet" will show a warning.
VITE_NETWORK=preview

# Deployed contract address on the target network.
# Leave empty until you run `compact deploy` for the first time.
VITE_CONTRACT_ADDRESS=

# URL of the Midnight proof-generation server.
# For local development, Docker runs this on port 6300.
VITE_PROOF_SERVER_URL=http://localhost:6300
